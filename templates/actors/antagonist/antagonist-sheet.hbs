<div class="antagonist-content">
    <div class="section mt-1">
        <div class="section-title">
            <img src="https://jp.finalfantasyxvi.com/assets/images/top/news/arrow.svg" />
            <h2>{{localize 'roe.general.information'}}</h2>
        </div>
    </div>

    <div class="antagonist-row">
        <div class="antagonist-col">
            <div class="antagonist-form-row">
                <label for="name">{{localize 'roe.general.name'}}</label>
                <input name="name" type="text" value="{{actor.name}}" placeholder="{{localize 'roe.general.protagonist'}}" data-dtype="String" />
            </div>

            <div class="antagonist-form-row">
                <label for="system.level">{{localize 'roe.general.level'}}</label>
                <input name="system.level" type="number" value="{{data.system.level}}" data-dtype="Number"/>
            </div>

            <div class="antagonist-form-row">
                <label for="system.size">{{localize 'roe.general.size'}}</label>
                <select name="system.size">
                    {{selectOptions config.size selected=data.system.size localize=true}}
                </select>
            </div>

            <div class="antagonist-form-row">
                <label for="system.speed">{{localize 'roe.general.speed'}}</label>
                <select name="system.speed">
                    {{selectOptions config.speed selected=data.system.speed localize=true}}
                </select>
            </div>
        </div>

        <div class="antagonist-col">
            <div class="antagonist-form-row">
                <label for="system.species">{{localize 'roe.general.species'}}</label>
                <select name="system.species">
                    {{selectOptions config.species selected=data.system.species localize=true}}
                </select>
            </div>

            <div class="antagonist-form-row">
                <label for="system.archetype1">{{localize 'roe.general.archetype'}} 1</label>
                <select name="system.archetype1">
                    {{selectOptions config.archetypes selected=data.system.archetype1 localize=true}}
                </select>
            </div>

            <div class="antagonist-form-row">
                <label for="system.archetype2">{{localize 'roe.general.archetype'}} 2</label>
                <select name="system.archetype2">
                    {{selectOptions config.archetypes selected=data.system.archetype2 localize=true}}
                </select>
            </div>

            <div class="antagonist-form-row">
                <label for="system.power">{{localize 'roe.general.power'}}</label>
                <input name="system.power" type="number" value="{{data.system.power}}" data-dtype="Number"/>
            </div>
        </div>
    </div>

    <div class="section mt-1">
        <div class="section-title">
            <img src="https://jp.finalfantasyxvi.com/assets/images/top/news/arrow.svg" />
            <h2>{{localize 'roe.general.traits'}}</h2>
        </div>
    </div>

    <p>Escolha {{ data.system.traitsInitial }} traços e receba +1 por nível</p>

    <select class="antagonist-trait-selected mt-1">
        <option value="none"></option>
        {{#each antagonistTraits as |trait|}}
            <option value="{{trait.label}}|{{trait.description}}">{{trait.label}}</option>
        {{/each}}
    </select>

    <div class="traits">
        {{#each system.traits as |trait|}}
            <div class="traits-action">
                <p data-tooltip="{{trait.description}}" data-tooltip-direction="UP">{{trait.label}}</p>
                <a class="antagonist-trait-delete" data-trait="{{trait.label}}">
                    <i class="fa-regular fa-circle-xmark"></i>
                </a>
            </div>
        {{/each}}
    </div>

    <div class="antagonist-form-col">
        <label for="system.traitsNotes">{{localize 'roe.general.traitsNotes'}}</label>
        <textarea name="system.traitsNotes" rows="8">{{data.system.traitsNotes}}</textarea>
    </div> 

    <div class="section mt-1">
        <div class="section-title">
            <img src="https://jp.finalfantasyxvi.com/assets/images/top/news/arrow.svg" />
            <h2>{{localize 'roe.general.combat'}}</h2>
        </div>

        <div class="section-form">
            <label for="system.rollModifier">Rolagem</label>
            <select name="system.rollModifier">
                {{selectOptions config.rollModifier selected=data.system.rollModifier localize=true}}
            </select>
        </div>  
    </div>

    <div class="antagonist-row">
        <div class="antagonist-col">
           <div class="actions-title">
                <div class="sub-section">
                    <img src="https://jp.finalfantasyxvi.com/assets/images/common/symbol/text/marker_obj.svg" alt="{{localize 'roe.goals.shortTerm'}}">
                    <h3>Recursos</h3>
                    <img src="https://jp.finalfantasyxvi.com/assets/images/common/symbol/text/marker_obj.svg" alt="{{localize 'roe.goals.shortTerm'}}">
                </div>
            </div>

            <div class="antagonist-form-row">
                <label for="system.healthPoints.max" class="red">{{localize 'roe.general.healthPoints'}}</label>
                <input name="system.healthPoints.value" type="number" value="{{data.system.healthPoints.value}}" data-dtype="Number" />
                <p>/</p>
                <input name="system.healthPoints.max" type="number" value="{{data.system.healthPoints.max}}" data-dtype="Number" />
                <p>◆</p>
                <input name="system.healthPoints.mod" type="number" value="{{data.system.healthPoints.mod}}" data-dtype="Number" />
            </div>

            <div class="antagonist-form-row">
                <label for="system.etherPoints.max" class="blue">{{localize 'roe.general.etherPoints'}}</label>
                <input name="system.etherPoints.value" type="number" value="{{data.system.etherPoints.value}}" data-dtype="Number" />
                <p>/</p>
                <input name="system.etherPoints.max" type="number" value="{{data.system.etherPoints.max}}" data-dtype="Number" />
                <p>◆</p>
                <input name="system.etherPoints.mod" type="number" value="{{data.system.etherPoints.mod}}" data-dtype="Number" />
            </div>

           <div class="actions-title mt-1">
                <div class="sub-section">
                    <img src="https://jp.finalfantasyxvi.com/assets/images/common/symbol/text/marker_obj.svg" alt="{{localize 'roe.goals.shortTerm'}}">
                    <h3>Proteções</h3>
                    <img src="https://jp.finalfantasyxvi.com/assets/images/common/symbol/text/marker_obj.svg" alt="{{localize 'roe.goals.shortTerm'}}">
                </div>
            </div>

            <div class="antagonist-form-row">
                <label for="system.physicalDamageResistance">{{localize 'roe.general.physicalDamageResistance'}}</label>
                <input name="system.physicalDamageResistance" type="number" value="{{data.system.physicalDamageResistance}}" data-dtype="Number"/>
            </div>

            <div class="antagonist-form-row">
                <label for="system.magicalDamageResistance">{{localize 'roe.general.magicalDamageResistance'}}</label>
                <input name="system.magicalDamageResistance" type="number" value="{{data.system.magicalDamageResistance}}" data-dtype="Number"/>
            </div>

            <div class="actions-title mt-1">
                <div class="sub-section">
                    <img src="https://jp.finalfantasyxvi.com/assets/images/common/symbol/text/marker_obj.svg" alt="{{localize 'roe.goals.shortTerm'}}">
                    <h3>{{localize 'roe.general.actions'}}</h3>
                    <img src="https://jp.finalfantasyxvi.com/assets/images/common/symbol/text/marker_obj.svg" alt="{{localize 'roe.goals.shortTerm'}}">
                </div>
                <a class="item-create" data-type="action" title="{{localize 'roe.general.add'}} {{localize 'roe.general.actions'}}">
                    <i class="fas fa-square-plus"></i>
                </a>
            </div>

            {{#each items as |action|}}
                <div class="item action-item" data-id="{{action._id}}">
                    <div class="action-item-col">
                        <div class="action-item-row">
                            <img src="{{action.img}}" alt="{{ability.name}}">

                            <input class="item-edit-inline" data-field="name" type="text" value="{{action.name}}" data-dtype="String"/>
                            
                            <a class="roll" data-roll-type="action" data-name="{{action.name}}" title="{{localize 'roe.general.roll'}}">
                                <i class="fas fa-dice"></i>
                            </a>

                            <a class="item-edit-popup" data-type="equipment" title="{{localize 'roe.general.edit'}} {{localize 'roe.general.abilities'}}">
                                <i class="fas fa-pen-to-square"></i>
                            </a>      

                            <a class="item-delete" data-type="equipment" title="{{localize 'roe.general.delete'}} {{localize 'roe.general.abilities'}}">
                                <i class="fas fa-trash"></i>
                            </a>  
                        </div>
                        
                        {{#if action.system.traits}}
                            <div class="traits">
                                {{#each action.system.traits as |trait|}}
                                    <p data-tooltip="{{trait.description}}" data-tooltip-direction="UP">{{trait.label}}</p>
                                {{/each}}
                            </div>
                        {{/if}}
                    </div>
                </div>
            {{/each}}
        </div>

        <div class="antagonist-col">
            <div class="actions-title">
                <div class="sub-section">
                    <img src="https://jp.finalfantasyxvi.com/assets/images/common/symbol/text/marker_obj.svg" alt="{{localize 'roe.goals.shortTerm'}}">
                    <h3>Ataques Básicos</h3>
                    <img src="https://jp.finalfantasyxvi.com/assets/images/common/symbol/text/marker_obj.svg" alt="{{localize 'roe.goals.shortTerm'}}">
                </div>
            </div>

            <div class="antagonist-form-col">
                <a class="roll" data-roll-type="action-basic" data-name="{{localize 'roe.basicAttacks.melee'}}" data-attribute="{{data.system.melee.value}}" data-attribute-modifier="{{data.system.melee.mod}}" title="{{localize 'roe.general.roll'}}">
                    {{localize 'roe.basicAttacks.melee'}}
                </a>

                <div class="antagonist-form-row">
                    <input name="system.melee.value" type="number" value="{{data.system.melee.value}}" data-dtype="Number" />
                    <p>◆</p>
                    <input name="system.melee.mod" type="number" value="{{data.system.melee.mod}}" data-dtype="Number" />
                </div>
            </div>

            <div class="antagonist-form-col">
                <a class="roll" data-roll-type="action-basic" data-name="{{localize 'roe.basicAttacks.distance'}}" data-attribute="{{data.system.distance.value}}" data-attribute-modifier="{{data.system.distance.mod}}" title="{{localize 'roe.general.roll'}}">
                    {{localize 'roe.basicAttacks.distance'}}
                </a>
                
                <div class="antagonist-form-row">
                    <input name="system.distance.value" type="number" value="{{data.system.distance.value}}" data-dtype="Number" />
                    <p>◆</p>
                    <input name="system.distance.mod" type="number" value="{{data.system.distance.mod}}" data-dtype="Number" />
                </div>

            </div>

            <div class="antagonist-form-col">
                <a class="roll" data-roll-type="action-basic" data-name="{{localize 'roe.basicAttacks.ressonance'}}" data-attribute="{{data.system.ressonance.value}}" data-attribute-modifier="{{data.system.ressonance.mod}}" title="{{localize 'roe.general.roll'}}">
                    {{localize 'roe.basicAttacks.ressonance'}}
                </a>

                <div class="antagonist-form-row">
                    <input name="system.ressonance.value" type="number" value="{{data.system.ressonance.value}}" data-dtype="Number" />
                    <p>◆</p>
                    <input name="system.ressonance.mod" type="number" value="{{data.system.ressonance.mod}}" data-dtype="Number" />
                </div>
            </div>

            <div class="actions-title mt-1">
                <div class="sub-section">
                    <img src="https://jp.finalfantasyxvi.com/assets/images/common/symbol/text/marker_obj.svg" alt="{{localize 'roe.goals.shortTerm'}}">
                    <h3>Defesas Básicas</h3>
                    <img src="https://jp.finalfantasyxvi.com/assets/images/common/symbol/text/marker_obj.svg" alt="{{localize 'roe.goals.shortTerm'}}">
                </div>
            </div>

             <div class="antagonist-form-col">
                <a class="roll" data-roll-type="action-basic" data-name="{{localize 'roe.basicDefenses.agile'}}" data-attribute="{{data.system.agile.value}}" data-attribute-modifier="{{data.system.agile.mod}}" title="{{localize 'roe.general.roll'}}">
                    {{localize 'roe.basicDefenses.agile'}}
                </a>

                <div class="antagonist-form-row">
                    <input name="system.agile.value" type="number" value="{{data.system.agile.value}}" data-dtype="Number" />
                    <p>◆</p>
                    <input name="system.agile.mod" type="number" value="{{data.system.agile.mod}}" data-dtype="Number" />
                </div>
            </div>

            <div class="antagonist-form-col">
                <a class="roll" data-roll-type="action-basic" data-name="{{localize 'roe.basicDefenses.physical'}}" data-attribute="{{data.system.physical.value}}" data-attribute-modifier="{{data.system.physical.mod}}" title="{{localize 'roe.general.roll'}}">
                    {{localize 'roe.basicDefenses.physical'}}
                </a>

                <div class="antagonist-form-row">
                    <input name="system.physical.value" type="number" value="{{data.system.physical.value}}" data-dtype="Number" />
                    <p>◆</p>
                    <input name="system.physical.mod" type="number" value="{{data.system.physical.mod}}" data-dtype="Number" />
                </div>
            </div>

            <div class="antagonist-form-col">
                <a class="roll" data-roll-type="action-basic" data-name="{{localize 'roe.basicDefenses.mental'}}" data-attribute="{{data.system.mental.value}}" data-attribute-modifier="{{data.system.mental.mod}}" title="{{localize 'roe.general.roll'}}">
                    {{localize 'roe.basicDefenses.mental'}}
                </a>

                <div class="antagonist-form-row">
                    <input name="system.mental.value" type="number" value="{{data.system.mental.value}}" data-dtype="Number" />
                    <p>◆</p>
                    <input name="system.mental.mod" type="number" value="{{data.system.mental.mod}}" data-dtype="Number" />
                </div>
            </div>
        </div>
    </div>
</div>