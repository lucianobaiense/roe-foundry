    <div class="content-row">
        <div class="value-title">
            <img src="https://br.finalfantasyxvi.com/_next/static/media/divider_decoration.3b3edfdf.png" alt="">
            {{!-- <h2>Armadura: <span class="light">{{system.armorName}}</span></h2> --}}
            <h2>Armadura</span></h2>
        </div>

        <a class="show-dialog" data-label="Armadura" data-template="systems/roe/templates/dialogs/equiped-armor.hbs">
            <i class="fa-solid fa-cog"></i>
        </a>
    </div>

    {{#if system.armorName}}
        <div class="combat-area mt-1">
            <div class="combat-row">
                <p>
                    {{system.armorName}}:
                    Resistência Física<span class="combat-marker">{{system.physicalResistance}}</span>
                    Resistência Mágica<span class="combat-marker">{{system.magicalResistance}}</span>    
                </p>
                {{!-- <p>Resistência Mágica <span class="combat-marker">{{system.magicalResistance}}</span></p> --}}
            </div>
            <div class="traits">
                {{getTraits data.system.armorTraits armorTraits}}
            </div>
        </div>
    {{/if}}

    <div class="content-row mb-1">
        <div class="value-title">
            <img src="https://br.finalfantasyxvi.com/_next/static/media/divider_decoration.3b3edfdf.png" alt="">
            <h2>Ações</h2>
        </div>
        <a class="item-create" data-type="action" title="{{localize 'roe.general.add'}} {{localize 'roe.general.actions'}}">
            <i class="fas fa-square-plus"></i>
        </a>
    </div>

    {{#each actions as |action|}}
        <div class="item action-item content-row" data-id="{{action._id}}" draggable="true">
            <div class="item-row">
                <img src="{{action.img}}" alt="{{ability.name}}">

                {{#if (and action.system.cost action.system.damage)}}
                    <p>{{action.name}} ( {{localize (concat "roe.actionTypesShort." action.system.action)}}, {{action.system.cost}} ): Dano {{action.system.damage}} ({{action.system.damageCritical}})</p>  
                {{else if action.system.cost}}
                    <p>{{action.name}} ( {{localize (concat "roe.actionTypesShort." action.system.action)}}, {{action.system.cost}})</p>  
                {{else if action.system.damage}}
                    <p>{{action.name}} ( {{localize (concat "roe.actionTypesShort." action.system.action)}} ): Dano {{action.system.damage}} ({{action.system.damageCritical}})</p>  
                {{else }}
                    <p>{{action.name}} ( {{localize (concat "roe.actionTypesShort." action.system.action)}} )</p>  
                {{/if}}
                
                <a class="roll roll-area" data-roll-type="action" data-roll-mod="{{action.system.rollMod}}" data-name="{{action.name}}" title="{{localize 'roe.general.roll'}}">
                    <i class="fas fa-dice"></i>{{localize (concat "roe.rollModifier." action.system.rollMod)}}
                </a>

                <a class="item-edit-popup" data-type="equipment" title="{{localize 'roe.general.edit'}} {{localize 'roe.general.abilities'}}">
                    <i class="fas fa-pen-to-square"></i>
                </a>      

                <a class="item-delete" data-type="equipment" title="{{localize 'roe.general.delete'}} {{localize 'roe.general.abilities'}}">
                    <i class="fas fa-trash"></i>
                </a>  
            </div>
        </div>
    {{/each}}
</div>