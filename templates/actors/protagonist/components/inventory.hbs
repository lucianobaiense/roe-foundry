<div class="section">
    <div class="section-title">
        <img class="mirror" src="https://br.finalfantasyxvi.com/_next/static/media/decoration.d307c720.svg" alt="">
        <h2>Inventário</h2>
        <img src="https://br.finalfantasyxvi.com/_next/static/media/decoration.d307c720.svg" alt="">
    </div>

    <div class="add-item">
        <a class="item-create" data-type="equipment" title="{{localize 'roe.general.add'}} {{localize 'roe.general.equipments'}}">
            <i class="fas fa-square-plus"></i>
        </a>
    </div>

    {{#if (eq data.type "protagonist")}}
        <div class="inventary">
            <p>Limite de Espaços {{ actor.system.slots }} / {{ actor.system.maxSlots }} ( Sobrecarga {{actor.system.overweight}} )</p>
            
            <div class="form-row">
                <label for="system.geo">{{localize 'roe.general.geo'}}</label>
                <input name="system.geo" type="number" value="{{actor.system.geo}}" data-dtype="Number"/>
            </div>
        </div>
    {{/if}}

    {{#each equipments as |equipment|}}
        <div class="item inventary-item content-row" data-id="{{equipment._id}}">
            <div class="item-row">
                <img src="{{equipment.img}}" alt="{{equipment.name}}">

                <p>{{equipment.name}}</p>

                {{#if (gt equipment.system.durability 0)}}
                    <div class="inventary-row">
                        <label for="system.durability">DU</label>
                        <input class="item-edit-inline" data-field="system.durability" type="text" value="{{equipment.system.durability}}" data-dtype="Number"/>
                    </div>
                {{/if}}

                <a class="inventory-roll" data-type="equipment" data-name="{{equipment.name}}">
                    <i class="fa-solid fa-comment"></i>
                </a>     

                <a class="item-edit-popup" data-type="equipment" title="{{localize 'roe.general.edit'}} {{localize 'roe.general.equipments'}}">
                    <i class="fas fa-pen-to-square"></i>
                </a>      

                <a class="item-delete" data-type="equipment" title="{{localize 'roe.general.delete'}} {{localize 'roe.general.equipments'}}">
                    <i class="fas fa-trash"></i>
                </a>
            </div>
        </div>
    {{/each}}
</div>