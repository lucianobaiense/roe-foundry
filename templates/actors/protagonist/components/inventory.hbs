<div class="inventary">
    <div class="section">
        <div class="section-title">
            <img src="https://jp.finalfantasyxvi.com/assets/images/top/news/arrow.svg" />
            <h2>{{localize 'roe.general.inventary'}}</h2>
        </div>

        <a class="item-create" data-type="equipment" title="{{localize 'roe.general.add'}} {{localize 'roe.general.equipments'}}">
            <i class="fas fa-square-plus"></i>
        </a>
    </div>

    {{#if (eq data.type "protagonist")}}
        <p class="spaces">Limite de Espaços {{ data.system.slots }} / {{ data.system.maxSlots }} ( Sobrecarga {{data.system.overweight}} )</p>
    {{/if}}
    
    {{#each equipments as |equipment|}}
        <div class="item inventary-item" data-id="{{equipment._id}}">
            <div class="inventary-col">
                <div class="inventary-row">
                    <img src="{{equipment.img}}" alt="{{equipment.name}}">

                    <input class="item-edit-inline" data-field="name" type="text" value="{{equipment.name}}" data-dtype="String"/>

                    <a class="inventory-roll" data-type="equipment" data-name="{{equipment.name}}">
                        <i class="fa-solid fa-comment"></i>
                    </a>     

                    <a class="item-edit-popup" data-type="equipment" title="{{localize 'roe.general.edit'}} {{localize 'roe.general.equipments'}}">
                        <i class="fas fa-pen-to-square"></i>
                    </a>      

                    <a class="item-delete" data-type="equipment" title="{{localize 'roe.general.delete'}} {{localize 'roe.general.equipments'}}">
                        <i class="fas fa-trash"></i>
                    </a>    
                </div>

                {{#if equipment.system.traits}}
                    <div class="traits">
                        {{#each equipment.system.traits as |equipmentTrait|}}
                            <p data-tooltip="{{equipmentTrait.description}}" data-tooltip-direction="UP">{{equipmentTrait.label}}</p>
                        {{/each}}
                    </div>
                {{/if}}  
            </div>
        </div>
    {{/each}}       
</div>