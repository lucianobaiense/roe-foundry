<div class="section">
    <div class="section-title">
        <img class="mirror" src="https://br.finalfantasyxvi.com/_next/static/media/decoration.d307c720.svg" alt="">
        <h2>Habilidades</h2>
        <img src="https://br.finalfantasyxvi.com/_next/static/media/decoration.d307c720.svg" alt="">
    </div>

    <div class="add-item">
        <a class="item-create" data-type="ability" title="{{localize 'roe.general.add'}} {{localize 'roe.general.abilities'}}">
            <i class="fas fa-square-plus"></i>
        </a>
    </div>

    {{#each abilities as |ability|}}
        <div class="item ability-item content-row" data-id="{{ability._id}}" draggable="true">
            <div class="item-row">
                <img src="{{ability.img}}" alt="{{ability.name}}">

                {{!-- <p class="level-log">{{ability.system.levelLog}}</p> --}}
                
                {{#if ability.system.cost }}
                    <p>{{ability.system.levelLog}} - {{ability.name}} ( {{localize (concat "roe.actionTypesShort." ability.system.action)}}, {{ability.system.cost}} {{localize (concat "roe.costTypes." ability.system.costResource)}} )</p>  
                {{else}}
                    <p>{{ability.system.levelLog}} - {{ability.name}} ( {{localize (concat "roe.actionTypesShort." ability.system.action)}} )</p>  
                {{/if}}
                
                <a class="ability-roll" data-type="ability" data-name="{{ability.name}}">
                    <i class="fa-solid fa-comment"></i>
                </a>

                <a class="item-edit-popup" data-type="equipment" title="{{localize 'roe.general.edit'}} {{localize 'roe.general.abilities'}}">
                    <i class="fas fa-pen-to-square"></i>
                </a>      

                <a class="item-delete" data-type="equipment" title="{{localize 'roe.general.delete'}} {{localize 'roe.general.abilities'}}">
                    <i class="fas fa-trash"></i>
                </a> 
            </div>
        </div>
    {{/each}}
</div>