<div class="goals">
    <div class="section">
        <div class="section-title">
            <img src="https://jp.finalfantasyxvi.com/assets/images/top/news/arrow.svg" alt="{{localize 'roe.general.goals'}}" />
            <h2>{{localize 'roe.general.goals'}}</h2>
        </div>
    </div>

    <div class="goals-row">
        <div class="goals-short">
            <div class="sub-section">
                <img src="https://jp.finalfantasyxvi.com/assets/images/common/symbol/text/marker_obj.svg" alt="{{localize 'roe.goals.shortTerm'}}">
                <h3>{{localize 'roe.goals.shortTerm'}}</h3>
                <img src="https://jp.finalfantasyxvi.com/assets/images/common/symbol/text/marker_obj.svg" alt="{{localize 'roe.goals.shortTerm'}}">
            </div>
            
            <div class="goals-form">
                <label for="system.goals.chronicleShort">{{localize 'roe.goals.chronicle'}}</label>
                <input name="system.goals.chronicleShort" type="text" value="{{data.system.goals.chronicleShort}}" data-dtype="String" />
            </div>

            <div class="goals-form">
                <label for="system.goals.personalShort">{{localize 'roe.goals.personal'}}</label>
                <input name="system.goals.personalShort" type="text" value="{{data.system.goals.personalShort}}" data-dtype="String" />
            </div>
        </div>

        <div class="goals-long">
            <div class="sub-section">
                <img src="https://jp.finalfantasyxvi.com/assets/images/common/symbol/text/marker_obj.svg" alt="{{localize 'roe.goals.longTerm'}}">
                <h3>{{localize 'roe.goals.longTerm'}}</h3>
                <img src="https://jp.finalfantasyxvi.com/assets/images/common/symbol/text/marker_obj.svg" alt="{{localize 'roe.goals.longTerm'}}">
            </div>

            <div class="goals-form">
                <label for="system.goals.chronicleLong">{{localize 'roe.goals.chronicle'}}</label>
                <input name="system.goals.chronicleLong" type="text" value="{{data.system.goals.chronicleLong}}" data-dtype="String" />
            </div>

            <div class="goals-form">
                <label for="system.goals.personalLong">{{localize 'roe.goals.personal'}}</label>
                <input name="system.goals.personalLong" type="text" value="{{data.system.goals.personalLong}}" data-dtype="String" />
            </div>
        </div>
    </div>
</div>