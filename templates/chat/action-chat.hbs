<div class="chat">
    <div class="chat-row">
        <img src="{{img}}" alt="{{name}}"/>

        {{#if actionFlavor}}
            <div class="chat-flavor">
                {{safe actionFlavor}}
            </div>
        {{/if}}
    </div>

    {{#if hit}}
        <hr>

        <div class="chat-row">
            {{#unless (eq hit 0)}}
                {{#if (eq rollMod "advantage")}}
                    <div class="chat-roll">
                        <p class="chat-roll-title chat-roll-title-advantage">{{localize "roe.general.roll"}}</p>

                        {{#if (eq actor.type "protagonist")}} 
                            <p>[[ (2d6 + {{hit}}) + 1d4 ]] (2d6 + {{hit}}) + 1d4</p> 
                        {{/if}}
                        
                        {{#if (eq actor.type "antagonist")}} 
                            <p>[[ (2d6 + {{hit}}) + 1d4 ]]</p> 
                        {{/if}}
                    </div>
                {{/if}}

                {{#if (eq rollMod "disadvantage")}}
                    <div class="chat-roll">
                        <p class="chat-roll-title chat-roll-title-disadvantage">{{localize "roe.general.roll"}}</p>

                        {{#if (eq actor.type "protagonist")}} 
                            <p>[[ (2d6 + {{hit}}) - 1d4 ]] (2d6 + {{hit}}) - 1d4</p> 
                        {{/if}}
                        
                        {{#if (eq actor.type "antagonist")}} 
                            <p>[[ (2d6 + {{hit}}) - 1d4 ]]</p> 
                        {{/if}}
                    </div>
                {{/if}}

                {{#if (eq rollMod "regular")}}
                    <div class="chat-roll">
                        <p class="chat-roll-title">{{localize "roe.general.roll"}}</p> 
                        
                        {{#if (eq actor.type "protagonist")}} 
                            <p>[[ 2d6 + {{hit}} ]] (2d6 + {{hit}}) </p>
                        {{/if}}
                                    
                        {{#if (eq actor.type "antagonist")}}
                            <p>[[ 2d6 + {{hit}} ]]</p> 
                        {{/if}}
                    </div>
                {{/if}}
            {{/unless}} 
        </div>
    {{/if}}

    {{#if cost}}
        <hr>
        
        <div class="chat-row">
            <div class="chat-col">
                <div class="chat-roll">
                    <p class="chat-roll-title">{{localize "roe.action.cost"}}</p>
                    <p>{{cost}}</p>
                </div>                
            </div>
        </div>
    {{/if}}

    <hr>

    <div class="chat-row">
        <div class="chat-col">
            <div class="chat-roll">
                <p class="chat-roll-title">{{localize "roe.action.action"}}</p>
                <p>{{localize (concat "roe.actionUses." action)}}</p>
            </div>                
        </div>
    </div>

    {{#if damage}}
        <hr>

        <div class="chat-row">
            <div class="chat-col">
                    <div class="chat-roll">
                        <p class="chat-roll-title">{{localize "roe.action.damage"}}</p>
                        
                        {{#if (eq actor.type "protagonist")}} 
                            <p>
                                [[/r {{damage}} ]] 
                                {{localize (concat "roe.damageTypes." damageType)}}
                            </p>
                        {{/if}}

                        {{#if (eq actor.type "antagonist")}} 
                            <p>
                                [[/roll ({{damage}}) ]]{Rolar}
                                {{localize (concat "roe.damageTypes." damageType)}} 
                            </p>
                        {{/if}}
                    </div>                
            </div>
        </div>
    {{/if}}

    {{#if damageCritical}}
        <hr>

        <div class="chat-row">
            <div class="chat-col">
                <div class="chat-roll">
                    <p class="chat-roll-title">{{localize "roe.action.damageCritical"}}</p>
                    
                    {{#if (eq actor.type "protagonist")}} 
                        <p>
                            [[/r {{damageCritical}} ]] 
                            {{localize (concat "roe.damageTypes." damageType)}}
                        </p>
                    {{/if}}

                    {{#if (eq actor.type "antagonist")}} 
                        <p>
                            [[/roll ({{damageCritical}}) ]]{Rolar}  
                            {{localize (concat "roe.damageTypes." damageType)}}
                        </p>
                    {{/if}}
                </div>
            </div>
        </div>
    {{/if}}

    {{#unless (eq hit 0)}}
        <hr>
        
        <div class="chat-row">
            <div class="chat-roll">
                <p class="chat-roll-title">Usar PN</p>
                [[/r {{actor.system.narrativePoints.dice}} ]]
            </div>
        </div>
    {{/unless}}
    
    {{#if description}}
        <hr>

        <p class="chat-section">{{localize "roe.action.description"}}</p> 
     
        <div class="chat-col">
            {{safe description}}
        </div>
    {{/if}}

    {{#if traits}}
        <hr>

        <p class="chat-section">{{localize "roe.general.traits"}}</p>    

        <div class="traits">
            {{#each traits as |trait|}}
                <p data-tooltip="{{trait.description}}" data-tooltip-direction="UP">{{trait.label}}</p>
            {{/each}}
        </div>
    {{/if}}

    {{#if activeConditions}}
        <hr>

        <p class="chat-section">{{localize "roe.general.conditions"}}</p>    

        <div class="traits">
            {{#each activeConditions as |condition|}}
                <div class="traits-action">
                    <p data-tooltip="{{condition.description}}" data-tooltip-direction="UP">{{condition.label}}</p>
                </div>
            {{/each}}
        </div>
    {{/if}}
</div>
