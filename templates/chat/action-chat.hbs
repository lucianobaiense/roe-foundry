<div class="chat">
    <div class="chat-row">
        <img src="{{img}}" alt="{{name}}"/>

        {{#if actionFlavor}}
            <div class="chat-flavor">
                {{safe actionFlavor}}
            </div>
        {{/if}}
    </div>

    {{#if hit}}
        <hr>

        <div class="chat-row">
            {{#if (eq rollModifier "advantage")}}
                <div class="chat-roll">
                    <p class="chat-roll-title chat-roll-title-advantage">{{localize "roe.general.result"}}</p>

                    {{#if (eq actor.type "protagonist")}} 
                        <p>[[ 3d6kh2 + {{hit}} ]] ( 3d6kh2 + {{hit}} )</p> 
                    {{/if}}
                    
                    {{#if (eq actor.type "antagonist")}} 
                        <p>[[ 3d6kh2 + {{hit}} + {{power}} ]]</p> 
                    {{/if}}
                </div>
            {{/if}}

            {{#if (eq rollModifier "disadvantage")}}
                <div class="chat-roll">
                    <p class="chat-roll-title chat-roll-title-disadvantage">{{localize "roe.general.result"}}</p>

                    {{#if (eq actor.type "protagonist")}} 
                        <p>[[ 3d6kl2 + {{hit}} ]] ( 3d6kl2 + {{hit}} )</p>  
                    {{/if}}
                    
                    {{#if (eq actor.type "antagonist")}} 
                        <p>[[ 3d6kl2 + {{hit}} + {{power}} ]]</p> 
                    {{/if}}
                </div>
            {{/if}}

            {{#if (eq rollModifier "regular")}}
                <div class="chat-roll">
                    <p class="chat-roll-title">{{localize "roe.general.result"}}</p> 
                    
                    {{#if (eq actor.type "protagonist")}} 
                        <p>[[ 2d6 + {{hit}} ]] (2d6 + {{hit}}) </p>
                    {{/if}}
                                
                    {{#if (eq actor.type "antagonist")}}
                        <p>[[ 2d6 + {{hit}} + {{power}} ]]</p> 
                    {{/if}}
                </div>
            {{/if}}
        </div>
    {{/if}}

    {{#if damage}}
        <hr>

        <div class="chat-row">
            <div class="chat-col">
                
                    <div class="chat-roll">
                        <p class="chat-roll-title">{{localize "roe.action.damage"}}</p>
                        
                        {{#if (eq actor.type "protagonist")}} 
                            <p>
                                [[/r {{damage}} ]] 
                                ({{localize (concat "roe.damageTypes." i damageType)}})
                            </p>
                        {{/if}}

                        {{#if (eq actor.type "antagonist")}} 
                            <p>
                                [[/roll ({{damage}}+{{power}})[{{localize (concat "roe.damageTypes." i damageType)}}] ]]{Rolar} 
                                {{!-- [[ /r {{damage}} + {{power}} ]]{Rolar}  --}}
                                {{!-- ({{localize (concat "roe.damageTypes." i damageType)}}) --}}
                            </p>
                        {{/if}}
                    </div>                
            </div>
        </div>
    {{/if}}

    {{#if damageCritical}}
        <hr>

        <div class="chat-row">
            <div class="chat-col">
                <div class="chat-roll">
                    <p class="chat-roll-title">{{localize "roe.action.damageCritical"}}</p>
                    
                    {{#if (eq actor.type "protagonist")}} 
                        <p>
                            [[/r {{damageCritical}} ]] 
                            ({{localize (concat "roe.damageTypes." i damageType)}} / {{localize (concat "roe.damageTypes." i damageTypeCritical)}}) 
                        </p>
                    {{/if}}

                    {{#if (eq actor.type "antagonist")}} 
                        <p>
                            [[/roll ({{damageCritical}}+{{power}})[{{localize (concat "roe.damageTypes." i damageType)}} / {{localize (concat "roe.damageTypes." i damageTypeCritical)}}] ]]{Rolar} 
                            {{!-- [[/r {{damageCritical}} + ({{power}}*2) ]]{Rolar} 
                            ({{localize (concat "roe.damageTypes." i damageType)}} / {{localize (concat "roe.damageTypes." i damageTypeCritical)}})  --}}
                        </p>
                    {{/if}}
                </div>
            </div>
        </div>
    {{/if}}

    <hr>
    
    <div class="chat-row">
        <div class="chat-roll">
            <p class="chat-roll-title">Usar {{localize "roe.general.narrativePoints"}}</p>
            [[/r 1d6 ]]{Rolar}
        </div>
    </div>

    {{#if traits}}
        <hr>

        <div class="traits">
            {{#each traits as |trait|}}
                <p data-tooltip="{{trait.description}}" data-tooltip-direction="UP">{{trait.label}}</p>
            {{/each}}
        </div>
    {{/if}}
</div>
