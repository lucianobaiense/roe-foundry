<div class="chat">
    <div class="chat-row">
        {{!-- <img src="{{img}}" alt="{{name}}"/> --}}

        {{#if actionFlavor}}
            <div class="chat-flavor">
                {{safe actionFlavor}}
            </div>
        {{/if}}
    </div>

    {{#if (gt hit 0)}}
        <hr>

        <div class="chat-row">
            {{!-- {{#if (eq rollModifier "advantage")}}
                <div class="chat-roll">
                    <p class="chat-roll-title chat-roll-title-advantage">{{localize "roe.general.result"}}</p>

                    {{#if (eq actor.type "protagonist")}} 
                        <p>[[ 3d6kh2 + {{hit}} ]] ( 3d6kh2 + {{hit}} )</p> 
                    {{/if}}
                    
                    {{#if (eq actor.type "antagonist")}} 
                        <p>[[ 3d6kh2 + {{hit}} + {{power}} ]]</p> 
                    {{/if}}
                </div>
            {{/if}} --}}

            {{!-- {{#if (eq rollModifier "disadvantage")}}
                <div class="chat-roll">
                    <p class="chat-roll-title chat-roll-title-disadvantage">{{localize "roe.general.result"}}</p>

                    {{#if (eq actor.type "protagonist")}} 
                        <p>[[ 3d6kl2 + {{hit}} ]] ( 3d6kl2 + {{hit}} )</p>  
                    {{/if}}
                    
                    {{#if (eq actor.type "antagonist")}} 
                        <p>[[ 3d6kl2 + {{hit}} + {{power}} ]]</p> 
                    {{/if}}
                </div>
            {{/if}} --}}

            {{!-- {{#if (eq rollModifier "regular")}} --}}
                <div class="chat-roll">
                    <p class="chat-roll-title">{{localize "roe.general.result"}}</p> 
                    
                    {{#if (eq actor.type "protagonist")}} 
                        <p>[[ 2d6 + {{hit}} ]] (2d6 + {{hit}}) </p>
                    {{/if}}
                                
                    {{#if (eq actor.type "antagonist")}}
                        <p>[[ 2d6 + {{hit}} + {{power}} ]]</p> 
                    {{/if}}
                </div>
            {{!-- {{/if}} --}}
        </div>
    {{/if}}

    {{#if damage}}
        <hr>

        <div class="chat-row">
            <div class="chat-col">
                
                    <div class="chat-roll">
                        <p class="chat-roll-title">{{localize "roe.action.damage"}}</p>
                        
                        {{#if (eq actor.type "protagonist")}} 
                            <p>
                                [[/r {{damage}} ]] 
                                {{!-- ({{localize (concat "roe.damageTypes." i damageType)}}) --}}
                            </p>
                        {{/if}}

                        {{#if (eq actor.type "antagonist")}} 
                            <p>
                                [[/roll ({{damage}})[{{localize (concat "roe.damageTypes." i damageType)}}] ]]{Rolar} 
                                {{!-- [[ /r {{damage}} + {{power}} ]]{Rolar}  --}}
                                {{!-- ({{localize (concat "roe.damageTypes." i damageType)}}) --}}
                            </p>
                        {{/if}}
                    </div>                
            </div>
        </div>
    {{/if}}

    {{#if criticalDamage}}
        <hr>

        <div class="chat-row">
            <div class="chat-col">
                <div class="chat-roll">
                    <p class="chat-roll-title">{{localize "roe.action.damageCritical"}}</p>
                    
                    {{#if (eq actor.type "protagonist")}} 
                        <p>
                            [[/r {{criticalDamage}} ]] 
                            {{!-- ({{localize (concat "roe.damageTypes." i damageType)}} / {{localize (concat "roe.damageTypes." i damageTypeCritical)}})  --}}
                        </p>
                    {{/if}}

                    {{#if (eq actor.type "antagonist")}} 
                        <p>
                            [[/r {{criticalDamage}} ]] 
                            {{!-- [[/roll ({{criticalDamage}})[{{localize (concat "roe.damageTypes." i damageType)}} / {{localize (concat "roe.damageTypes." i damageTypeCritical)}}] ]]{Rolar}  --}}
                            {{!-- [[/r {{damageCritical}} + ({{power}}*2) ]]{Rolar} 
                            ({{localize (concat "roe.damageTypes." i damageType)}} / {{localize (concat "roe.damageTypes." i damageTypeCritical)}})  --}}
                        </p>
                    {{/if}}
                </div>
            </div>
        </div>
    {{/if}}

    {{#unless (eq hit 0)}}
        <hr>
        
        <div class="chat-row">
            <div class="chat-roll">
                <p class="chat-roll-title">Usar PN</p>
                [[/r {{actor.system.narrativePoints.dice}} ]]
            </div>
        </div>
    {{/unless}}

    {{#if traits}}
        <hr>

        <p class="chat-section">{{localize "roe.general.traits"}}</p>    

        <div class="traits">
            {{getTraits traits traitsList}} 
        </div>       
    {{/if}}

    {{#if activeConditions}}
        <hr>

        <p class="chat-section">{{localize "roe.general.conditions"}}</p>    

        <div class="traits">
            {{#each activeConditions as |condition|}}
                <div class="traits-action">
                    <p data-tooltip="{{condition.description}}" data-tooltip-direction="UP">{{condition.label}}</p>
                </div>
            {{/each}}
        </div>
    {{/if}}
</div>
