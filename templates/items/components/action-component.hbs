<div class="roe-item">
    <div class="roe-item-row">
        <div class="roe-item-form">
            <label for="system.hit">{{localize "roe.action.hit"}}</label>
            <input name="system.hit" type="number" value="{{data.system.hit}}" data-dtype="Number"/>    
        </div> 

        <div class="roe-item-form">
            <label for="system.damage">{{localize "roe.action.damage"}}</label>
            <input name="system.damage" type="text" value="{{data.system.damage}}" data-dtype="String"/>    
        </div> 

        <div class="roe-item-form">
            <label for="system.damageCritical">{{localize "roe.action.damageCritical"}}</label>
            <input name="system.damageCritical" type="text" value="{{data.system.damageCritical}}" data-dtype="String"/>    
        </div> 
    </div>

    <hr>

    <div class="roe-item-row">
        <div class="roe-item-form">
            <label for="system.damageType">{{localize "roe.action.damageType"}}</label>
            {{!-- <select name="system.damageType">
                {{#select data.system.damageType}}
                    {{#each config.damageTypes as |name types|}}
                        <option value="{{types}}">{{localize name}}</option>
                    {{/each}}
                {{/select}}
            </select> --}}
            <select name="system.damageType">
                {{selectOptions config.damageTypes selected=data.system.damageType localize=true}}
            </select>
        </div>

        <div class="roe-item-form">
            <label for="system.damageTypeCritical">{{localize "roe.action.damageTypeCritical"}}</label>
            {{!-- <select name="system.damageTypeCritical">
                {{#select data.system.damageTypeCritical}}
                    {{#each config.damageTypes as |name types|}}
                        <option value="{{types}}">{{localize name}}</option>
                    {{/each}}
                {{/select}}
            </select> --}}
            <select name="system.damageTypeCritical">
                {{selectOptions config.damageTypes selected=data.system.damageTypeCritical localize=true}}
            </select>
        </div>  
    </div>

    <hr>

    <div class="roe-item-col">
        <div class="roe-item-form">
            <label for="traits">{{localize "roe.action.traits"}}</label>
            {{!-- <select class="trait-selected" name="traits">
                {{#select traits}}
                    <option value="none"></option>
                    {{#each traits.weapon as |trait|}}
                        <option value="{{trait.label}}|{{trait.description}}">{{trait.label}}</option>
                    {{/each}}
                {{/select}}
            </select> --}}

            <select class="trait-selected">
                <option value="none"></option>
                {{#each traits.weapon as |trait|}}
                    <option value="{{trait.label}}|{{trait.description}}">{{trait.label}}</option>
                {{/each}}
            </select>
        </div>

        <div class="traits">
            {{#each system.traits as |trait|}}
                <div class="traits-action">
                    <p data-tooltip="{{trait.description}}" data-tooltip-direction="UP">{{trait.label}}</p>
                    <a class="trait-delete" data-trait="{{trait.label}}">
                        <i class="fa-regular fa-circle-xmark"></i>
                    </a>
                </div>
            {{/each}}
        </div>
    </div>

    <hr>

    <div class="roe-item-row">
        <div class="roe-item-form-col">
            <label for="system.flavor">{{localize "roe.action.flavor"}}</p>
            {{editor system.flavor target="system.flavor" button=true engine="tinymce" collaborate=false}}
        </div>
    </div>
</div>