<div class="mt-1">
    <div class="dialog-row">
        <label for="system.actionType">{{localize "roe.action.type"}}</label>
        <select name="system.actionType">
            {{selectOptions config.actionTypes selected=data.system.actionType localize=true}}
        </select>   
    </div>

    {{#if (eq data.system.actionType "physical")}}
        <hr>

        <div class="dialog-row">
            <label for="system.roll">{{localize "roe.general.roll"}}</label>
            <select name="system.roll">
                <option value="">-</option>
                {{selectOptions config.basicAttacks selected=data.system.roll localize=true}}
            </select>  
        </div> 
    {{/if}}

    {{#if (eq data.system.actionType "magical")}}
        <hr>

        <div class="dialog-row">
            <label for="system.roll">{{localize "roe.general.roll"}}</label>
            <select name="system.roll">
                <option value="">-</option>
                {{selectOptions config.sortileges selected=data.system.roll localize=true}}
            </select>  
        </div> 
    {{/if}}

    <div class="dialog-row">
        <label for="system.rollMod">Tipo de Rolagem</label>
        <select name="system.rollMod">
            {{selectOptions config.rollModifier selected=data.system.rollMod localize=true}}
        </select>  
    </div>  

    <hr>

    <div class="dialog-row">
        <label for="system.cost">{{localize "roe.action.cost"}}</label>
        <input name="system.cost" type="text" value="{{data.system.cost}}" data-dtype="String"/>  
    </div> 

    <hr>

    <div class="dialog-row">
        <label for="system.action">{{localize "roe.action.action"}}</label>
        <select name="system.action">
            {{selectOptions config.actionUses selected=data.system.action localize=true}}
        </select>
    </div>

    <hr>

    <div class="dialog-row">
        <label for="system.damageType">{{localize "roe.equipment.damageType"}}</label>
        <select name="system.damageType">
            {{selectOptions config.damageTypes selected=data.system.damageType localize=true}}
        </select>   
    </div>

    <div class="dialog-row">
        <label for="system.damage">{{localize "roe.action.damage"}}</label>
        <input name="system.damage" type="text" value="{{data.system.damage}}" data-dtype="String"/>   
    </div>

    <div class="dialog-row">
        <label for="system.damageCritical">{{localize "roe.action.damageCritical"}}</label>
        <input name="system.damageCritical" type="text" value="{{data.system.damageCritical}}" data-dtype="String"/>    
    </div>

    {{#if (eq data.system.actionType "physical")}}
        <hr>

        <div class="dialog-row">
            <label for="traits">{{localize "roe.action.traits"}}</label>
            <select class="trait-selected">
                <option value="none"></option>
                {{#each traits.weapon as |trait|}}
                    <option value="{{trait.label}}|{{trait.description}}">{{trait.label}}</option>
                {{/each}}
            </select>
        </div>
    {{/if}}

    {{#if (eq data.system.actionType "magical")}}
        <hr>

        <div class="dialog-row">
            <label for="traits">{{localize "roe.action.traits"}}</label>
            <select class="trait-selected">
                <option value="none"></option>
                {{#each traits.sortilege as |trait|}}
                    <option value="{{trait.label}}|{{trait.description}}">{{trait.label}}</option>
                {{/each}}
            </select>
        </div>
    {{/if}}

    <div class="traits">
        {{#each system.traits as |trait|}}
            <div class="traits-action">
                <p data-tooltip="{{trait.description}}" data-tooltip-direction="UP">{{trait.label}}</p>
                <a class="trait-delete" data-trait="{{trait.label}}">
                    <i class="fa-regular fa-circle-xmark"></i>
                </a>
            </div>
        {{/each}}
    </div>

    <hr>

    <div class="dialog-col">
        <label class="mb-1" for="system.flavor">{{localize "roe.action.description"}}</label>
        {{editor system.description target="system.description" button=true engine="tinymce" collaborate=false}}
    </div>

    <div class="dialog-col mt-1">
        <label class="mb-1" for="system.flavor">{{localize "roe.action.flavor"}}</label>
        {{editor system.flavor target="system.flavor" button=true engine="tinymce" collaborate=false}}
    </div>
</div>