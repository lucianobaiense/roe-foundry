<div class="roe-item">
    <div class="roe-item-row">
        <div class="roe-item-form">
            <label for="system.rank">{{localize "roe.ability.rank"}}</label>
            <input name="system.rank" type="number" value="{{data.system.rank}}" data-dtype="Number"/>    
        </div> 

        <div class="roe-item-form">
            <label for="system.type">{{localize "roe.ability.type"}}</label>
            {{!-- <select name="system.type">
                {{#select data.system.type}}
                    {{#each system.typeOptions as |name options|}}
                        <option value="{{options}}">{{localize name}}</option>
                    {{/each}}
                {{/select}}
            </select>    --}}
            <select name="system.type">
                {{selectOptions config.abilityTypes selected=data.system.type localize=true}}
            </select>
        </div>

        <div class="roe-item-form">
            <label for="system.prerequisite">{{localize "roe.ability.prerequisite"}}</label>
            <input name="system.prerequisite" type="text" value="{{data.system.prerequisite}}" data-dtype="String"/>    
        </div> 
    </div>

    {{#if (eq system.type "active" )}}
        <hr>

        <div class="roe-item-row">
            <div class="roe-item-form">
                <label for="system.action">{{localize "roe.ability.action"}}</label>
                {{!-- <select name="system.action">
                    {{#select data.system.action}}
                        {{#each config.actionTypes as |name actions|}}
                            <option value="{{actions}}">{{localize name}}</option>
                        {{/each}}
                    {{/select}}
                </select>   --}}
                <select name="system.action">
                    {{selectOptions config.actionTypes selected=data.system.action localize=true}}
                </select>
            </div>
        </div>

        <hr>

        <div class="roe-item-row">
            <div class="roe-item-form">
                <label for="system.cost">{{localize "roe.ability.cost"}}</label>
                <div class="roe-item-form">
                    <input name="system.cost" type="number" value="{{data.system.cost}}" data-dtype="Number"/>
                </div>
            </div>

            <div class="roe-item-form">
                {{!-- <select name="system.costResource">
                    {{#select data.system.costResource}}
                        <option value=""></option>
                        <option value="hp">PV</option>
                        <option value="ep">PE</option>
                        <option value="np">PN</option>
                        <option value="component">Componente</option>
                        <option value="other">Outro</option>
                    {{/select}}
                </select>  --}}
                <select name="system.costResource">
                    {{selectOptions config.abilityCostResource selected=data.system.costResource localize=true}}
                </select>
            </div>
        </div>

        <hr>

        <div class="roe-item-row">
            <div class="roe-item-form">
                <label for="system.duration">{{localize "roe.ability.duration"}}</label>
                <div class="roe-item-form">
                    <input name="system.duration" type="text" value="{{data.system.duration}}" data-dtype="String"/>
                </div>
            </div>
        </div>

        <hr>

        <div class="roe-item-row">
            <div class="roe-item-form">
                <label for="system.range">{{localize "roe.ability.range"}}</label>
                <div class="roe-item-form">
                    <input name="system.range" type="text" value="{{data.system.range}}" data-dtype="String"/>
                </div>
            </div>
        </div>

        <hr>

        <div class="roe-item-row">
            <div class="roe-item-form">
                <label for="system.target">{{localize "roe.ability.target"}}</label>
                <div class="roe-item-form">
                    <input name="system.target" type="text" value="{{data.system.target}}" data-dtype="String"/>
                </div>
            </div>
        </div>

        <hr>

        <div class="roe-item-row">
            <div class="roe-item-form">
                <label for="system.resistance">{{localize "roe.ability.resistance"}}</label>
                <div class="roe-item-form">
                    <input name="system.resistance" type="text" value="{{data.system.resistance}}" data-dtype="String"/>
                </div>
            </div>
        </div>

        <hr>

        <div class="roe-item-row">
            <div class="roe-item-form">
                <label for="system.sortilege">{{localize "roe.ability.sortilege"}}</label>
                {{!-- <select name="system.sortilege">
                    {{#select data.system.sortilege}}
                        <option value="no">Não</option>
                        <option value="yes">Sim</option>
                    {{/select}}
                </select>  --}}
                <select name="system.sortilege">
                    {{selectOptions config.abilitySortilege selected=data.system.sortilege localize=true}}
                </select>
            </div>
        </div>

        {{#if (eq system.sortilege "no" )}}
            <hr>
            
            <div class="roe-item-row">
                <div class="roe-item-form">
                    <label for="system.roll">{{localize "roe.ability.roll"}}</label>
                    {{!-- <select name="system.roll">
                        {{#select data.system.roll}}
                            <option value=""></option>
                            {{#each config.careers as |name career|}}
                                <option value="{{career}}">{{localize name}}</option>
                            {{/each}}
                        {{/select}}
                    </select> --}}
                    <select name="system.roll">
                        {{selectOptions config.careers selected=data.system.roll localize=true}}
                    </select> 
                </div>
            </div>     

            <div class="roe-item-row">
                <div class="roe-item-form">
                    <label for="system.difficulty">{{localize "roe.ability.difficulty"}}</label>
                    <div class="roe-item-form">
                        <input name="system.difficulty" type="number" value="{{data.system.difficulty}}" data-dtype="Number"/>
                    </div>
                </div>
            </div>
            
            <div class="roe-item-row">
                <div class="roe-item-form-col">
                    <label for="system.success">{{localize "roe.ability.success"}}</p>
                    {{editor system.success target="system.success" button=true engine="tinymce" collaborate=false}}
                </div>
            </div>

            <div class="roe-item-row">
                <div class="roe-item-form-col">
                    <label for="system.successCritical">{{localize "roe.ability.successCritical"}}</p>
                    {{editor system.successCritical target="system.successCritical" button=true engine="tinymce" collaborate=false}}
                </div>
            </div>
              
        {{/if}}

        {{#if (eq system.sortilege "yes" )}}            
            <div class="roe-item-row">
                <div class="roe-item-form-col">
                    <label for="system.success">{{localize "roe.ability.success"}}</p>
                    {{editor system.success target="system.success" button=true engine="tinymce" collaborate=false}}
                </div>
            </div>

            <div class="roe-item-row">
                <div class="roe-item-form-col">
                    <label for="system.successCritical">{{localize "roe.ability.successCritical"}}</p>
                    {{editor system.successCritical target="system.successCritical" button=true engine="tinymce" collaborate=false}}
                </div>
            </div>
        {{/if}}
    {{/if}}

    <hr>

    <div class="roe-item-col">
        <div class="roe-item-form">
            <label for="traits">{{localize "roe.ability.traits"}}</label>
            {{!-- <select class="trait-selected" name="traits">
                {{#select traits}}
                    <option value="none"></option>
                    {{#each traits.ability as |trait|}}
                        <option value="{{trait.label}}|{{trait.description}}">{{trait.label}}</option>
                    {{/each}}
                {{/select}}
            </select> --}}

            <select class="trait-selected">
                <option value="none"></option>
                {{#each traits.ability as |trait|}}
                    <option value="{{trait.label}}|{{trait.description}}">{{trait.label}}</option>
                {{/each}}
            </select>
        </div>

        <div class="traits">
            {{#each system.traits as |trait|}}
                <div class="traits-action">
                    <p data-tooltip="{{trait.description}}" data-tooltip-direction="UP">{{trait.label}}</p>
                    <a class="trait-delete" data-trait="{{trait.label}}">
                        <i class="fa-regular fa-circle-xmark"></i>
                    </a>
                </div>
            {{/each}}
        </div>
    </div>

    <hr>

    <div class="roe-item-row">
        <div class="roe-item-form-col">
            <label for="system.flavor">{{localize "roe.ability.flavor"}}</p>
            {{editor system.flavor target="system.flavor" button=true engine="tinymce" collaborate=false}}
        </div>
    </div>

    <hr>

    <div class="roe-item-row">
        <div class="roe-item-form-col">
            <label for="system.description">{{localize "roe.ability.description"}}</p>
            {{editor system.description target="system.description" button=true engine="tinymce" collaborate=false}}
        </div>
    </div>
</div>

