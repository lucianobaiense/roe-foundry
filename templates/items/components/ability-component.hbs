    <hr>

    <div class="dialog-col">
        <label class="mb-1" for="system.description">{{localize "roe.ability.description"}}</label>
        {{editor system.description target="system.description" button=true engine="tinymce" collaborate=false}}
    </div>

    <hr>

    <div class="dialog-col">
        <label class="mb-1" for="system.flavor">{{localize "roe.ability.flavor"}}</label>
        {{editor system.flavor target="system.flavor" button=true engine="tinymce" collaborate=false}}
    </div>
</div>